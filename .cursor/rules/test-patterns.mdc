## Assertions — required for every test

### Universal assertions
assert status == "success"
assert latest_result, "Worker result is empty"
assert artifacts, "Artifacts is empty"

### scene-construction specific
assert artifacts.get("draft_prose"), "draft_prose is empty"
prose = artifacts["draft_prose"]
assert not prose.startswith("{"), "draft_prose contains JSON"
assert "```" not in prose, "draft_prose contains code blocks"
assert not any(line.startswith("#") for line in prose.split("\n")),
    "draft_prose contains markdown headers"
assert artifacts.get("scene_metadata") is not None
assert artifacts["scene_metadata"].get("pov_character_id")
assert "kg_context_used" in artifacts
assert artifacts["kg_context_used"].get("character_node_found") is True

### pov-consistency-maintenance specific
assert "audit_header" in artifacts
overall_status = artifacts["audit_header"].get("overall_status")
assert overall_status in ("CLEAN", "VIOLATIONS FOUND")
assert "violation_log" in artifacts
assert isinstance(artifacts["violation_log"], list)
if overall_status == "VIOLATIONS FOUND":
    assert len(artifacts["violation_log"]) > 0
    for entry in artifacts["violation_log"]:
        assert "violation_type" in entry
        assert "offending_text" in entry
        assert "description" in entry
        assert "correction_note" in entry

### consequence-cascade-implementation specific
assert "cascade_chain" in artifacts
assert artifacts["cascade_chain"].get("action") in ("create_new", "extend_existing")
assert "consequence_bombs" in artifacts
bombs = artifacts["consequence_bombs"]
assert isinstance(bombs, list)
assert len(bombs) > 0, "No consequence bombs generated"
for bomb in bombs:
    trigger = bomb.get("properties", {}).get("detonation_trigger", "")
    assert trigger, "detonation_trigger is empty"
    # Must be a condition, not a chapter number
    assert not trigger.strip().startswith("Ch."), \
        f"detonation_trigger is a chapter number: {trigger}"
    assert not trigger.strip()[:3].replace(".", "").isdigit(), \
        f"detonation_trigger starts with a number: {trigger}"
assert "character_state_updates" in artifacts
assert isinstance(artifacts["character_state_updates"], list)

